web/_*.html

# Old local extraction scratch folder
gamedata/

# Game-file extractor: never commit keys, mappings, Oodle, exports or build output
extractor/out/
extractor/**/bin/
extractor/**/obj/
extractor/**/*.usmap
extractor/**/aes-key*.txt
extractor/**/oo2core*.dll
extractor/**/oodle*.dll

# Local helper tools that are never published.
extractor/keyscan/
